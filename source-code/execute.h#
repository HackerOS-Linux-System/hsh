;; ── AST ──────────────────────────────────────────────────────────────────
;; A tagged struct, not an enum — see README.md's porting notes for
;; why (matching on an imported enum is a known-unreliable path in
;; this interpreter). `kind` is one of: "cmd", "if", "while", "until",
;; "for", "func_def", "break", "continue", "return", "assign".

struct Stmt is
    pub kind: string
    pub text: string          ;; "cmd": the command text. "if"/"while"/"until": the condition text. "return": the code text (may be ""). "assign": "NAME=value".
    pub body: [Stmt]           ;; primary body: then-branch / while-body / until-body / for-body / function-body
    pub elif_conds: [string]    ;; "if" only: one condition text per elif, same order as elif_bodies
    pub elif_bodies: [[Stmt]]    ;; "if" only: one body per elif, same order as elif_conds
    pub else_body: [Stmt]         ;; "if" only
    pub for_var: string             ;; "for" only
    pub for_words: string            ;; "for" only: the raw " in WORDS" text (expanded at run time)
    pub func_name: string             ;; "func_def" only
end

fn stmt_cmd(text: string) -> Stmt is
    return Stmt { kind: "cmd", text: text, body: [], elif_conds: [], elif_bodies: [],
                  else_body: [], for_var: "", for_words: "", func_name: "" }
end

;; ── line classification ──────────────────────────────────────────────────

fn strip_trailing_marker(line: string, marker: string) -> (string, bool) is
    let mut t = line.trim()
    let mut found = false

    if t == marker is return ("", true) end

    if t.ends_with(marker) is
        let before_marker = t[0..t.len() - marker.len()]
        let mut ends_cleanly = false
        if before_marker.ends_with(" ") is ends_cleanly = true end
        if before_marker.ends_with(";") is ends_cleanly = true end
        if before_marker.ends_with("\t") is ends_cleanly = true end
        if ends_cleanly is
            t = before_marker.trim()
            found = true
        end
    end

    if found is
        if t.ends_with(";") is t = t[0..t.len() - 1].trim() end
    end

    return (t, found)
end

fn line_keyword(line: string) -> string is
    let t = line.trim()
    return util::first_word(t)
end

;; ── block parser ─────────────────────────────────────────────────────────
;; `parse_block(lines, start, stop_words)` parses statements starting
;; at `lines[start]` until it hits a line whose keyword is in
;; `stop_words` (that line is NOT consumed — the caller inspects it).
;; Returns (statements, index_of_the_stopping_line_or_lines.len()).

pub fn parse_block(lines: [string], start: int, stop_words: [string]) -> ([Stmt], int) is
    let mut stmts: [Stmt] = []
    let mut i = start
    let mut stop_idx = lines.len()
    let mut stopped = false
    while i < lines.len() && !stopped is
        let cur = i
        let raw = lines[cur]
        let trimmed = raw.trim()

        if trimmed == "" is
            i = i + 1
        end
        if trimmed != "" is
            if trimmed.starts_with("#") is
                i = i + 1
            end
            if !trimmed.starts_with("#") is
                let kw = line_keyword(trimmed)
                if is_in(stop_words, kw) is
                    stop_idx = cur
                    stopped = true
                end
                if !stopped is
                    let (stmt, next_i) = parse_one(lines, cur)
                    stmts.push(stmt)
                    i = next_i
                end
            end
        end
    end
    if !stopped is stop_idx = lines.len() end
    return (stmts, stop_idx)
end

fn is_in(words: [string], w: string) -> bool is
    let mut i = 0
    let mut found = false
    while i < words.len() is
        let cur = i
        i = i + 1
        if words[cur] == w is found = true end
    end
    return found
end

;; Parses exactly one statement starting at `lines[at]` (which is not
;; blank/comment). Returns (statement, index_of_next_unconsumed_line).
fn parse_one(lines: [string], at: int) -> (Stmt, int) is
    let trimmed = lines[at].trim()
    let kw = line_keyword(trimmed)

    if kw == "if" is return parse_if(lines, at) end
    if kw == "while" is return parse_while(lines, at) end
    if kw == "until" is return parse_until(lines, at) end
    if kw == "for" is return parse_for(lines, at) end
    if kw == "function" is return parse_func_def(lines, at) end
    if kw == "break" is return (Stmt { kind: "break", text: "", body: [], elif_conds: [], elif_bodies: [], else_body: [], for_var: "", for_words: "", func_name: "" }, at + 1) end
    if kw == "continue" is return (Stmt { kind: "continue", text: "", body: [], elif_conds: [], elif_bodies: [], else_body: [], for_var: "", for_words: "", func_name: "" }, at + 1) end
    if kw == "return" is
        let arg = util::rest_after_first_word(trimmed)
        return (Stmt { kind: "return", text: arg, body: [], elif_conds: [], elif_bodies: [], else_body: [], for_var: "", for_words: "", func_name: "" }, at + 1)
    end

    ;; `NAME() { ... }` function definition (alternate syntax)
    if is_func_paren_def(trimmed) is return parse_func_paren_def(lines, at) end

    ;; plain assignment: `NAME=value` (no spaces before '=', matches
    ;; the original's simple heuristic)
    if is_plain_assignment(trimmed) is
        return (Stmt { kind: "assign", text: trimmed, body: [], elif_conds: [], elif_bodies: [], else_body: [], for_var: "", for_words: "", func_name: "" }, at + 1)
    end

    return (stmt_cmd(trimmed), at + 1)
end

fn is_func_paren_def(line: string) -> bool is
    let paren = line.index_of("()")
    if paren < 0 is return false end
    let name = line[0..paren].trim()
    if name == "" is return false end
    return util::is_alpha(name[0..1])
end

fn is_plain_assignment(line: string) -> bool is
    let eq = line.index_of("=")
    if eq <= 0 is return false end
    let name = line[0..eq]
    if name.contains(" ") is return false end
    if !util::is_alpha(name[0..1]) is return false end
    let mut i = 0
    let mut ok = true
    while i < name.len() is
        let cur = i
        i = i + 1
        if !util::is_alnum(name[cur..cur + 1]) is ok = false end
    end
    return ok
end

;; Extracts the condition text from a line starting with `kw` (e.g.
;; "if", "while", "until"), and whether a trailing "; then"/"; do"/
;; bare "then"/"do" was found on the SAME line.
fn extract_header(line: string, kw: string, marker: string) -> (string, bool) is
    let after_kw = line.trim()[kw.len()..line.trim().len()].trim()
    return strip_trailing_marker(after_kw, marker)
end

;; If `has_marker` is false, `next_i` points at a line that should be
;; a bare marker ("then"/"do") on its own — skip it if so. Returns the
;; index of the first body line either way.
fn skip_bare_marker(lines: [string], next_i: int, marker: string) -> int is
    let mut i = next_i
    let mut going = true
    while i < lines.len() && going is
        let cur = i
        let t = lines[cur].trim()
        if t == "" is
            i = i + 1
        end
        if t != "" is
            going = false
            if t == marker is i = i + 1 end
        end
    end
    return i
end

fn parse_if(lines: [string], at: int) -> (Stmt, int) is
    let (cond0, has_then0) = extract_header(lines[at], "if", "then")
    let mut body_start = at + 1
    if !has_then0 is body_start = skip_bare_marker(lines, at + 1, "then") end

    let (then_body, stop1) = parse_block(lines, body_start, ["elif", "else", "fi"])

    let mut elif_conds: [string] = []
    let mut elif_bodies: [[Stmt]] = []
    let mut else_body: [Stmt] = []
    let mut cursor = stop1
    let mut going = cursor < lines.len()
    while going is
        let kw = line_keyword(lines[cursor].trim())
        if kw == "elif" is
            let (econd, ehas) = extract_header(lines[cursor], "elif", "then")
            let mut ebody_start = cursor + 1
            if !ehas is ebody_start = skip_bare_marker(lines, cursor + 1, "then") end
            let (ebody, estop) = parse_block(lines, ebody_start, ["elif", "else", "fi"])
            elif_conds.push(econd)
            elif_bodies.push(ebody)
            cursor = estop
            going = cursor < lines.len()
        end
        if kw == "else" is
            let (eb, estop) = parse_block(lines, cursor + 1, ["fi"])
            else_body = eb
            cursor = estop
            going = false
        end
        if kw == "fi" is going = false end
        if kw != "elif" && kw != "else" && kw != "fi" is going = false end
    end

    let mut next_i = cursor
    if next_i < lines.len() is
        if line_keyword(lines[next_i].trim()) == "fi" is next_i = next_i + 1 end
    end

    let stmt = Stmt { kind: "if", text: cond0, body: then_body,
                       elif_conds: elif_conds, elif_bodies: elif_bodies,
                       else_body: else_body, for_var: "", for_words: "", func_name: "" }
    return (stmt, next_i)
end

fn parse_while(lines: [string], at: int) -> (Stmt, int) is
    let (cond, has_do) = extract_header(lines[at], "while", "do")
    let mut body_start = at + 1
    if !has_do is body_start = skip_bare_marker(lines, at + 1, "do") end
    let (body, stop_at) = parse_block(lines, body_start, ["done"])
    let mut next_i = stop_at
    if next_i < lines.len() is next_i = next_i + 1 end
    let stmt = Stmt { kind: "while", text: cond, body: body, elif_conds: [], elif_bodies: [],
                       else_body: [], for_var: "", for_words: "", func_name: "" }
    return (stmt, next_i)
end

fn parse_until(lines: [string], at: int) -> (Stmt, int) is
    let (cond, has_do) = extract_header(lines[at], "until", "do")
    let mut body_start = at + 1
    if !has_do is body_start = skip_bare_marker(lines, at + 1, "do") end
    let (body, stop_at) = parse_block(lines, body_start, ["done"])
    let mut next_i = stop_at
    if next_i < lines.len() is next_i = next_i + 1 end
    let stmt = Stmt { kind: "until", text: cond, body: body, elif_conds: [], elif_bodies: [],
                       else_body: [], for_var: "", for_words: "", func_name: "" }
    return (stmt, next_i)
end

;; `for VAR in WORDS; do ... done`
fn parse_for(lines: [string], at: int) -> (Stmt, int) is
    let (header, has_do) = extract_header(lines[at], "for", "do")
    let in_idx = header.index_of(" in ")
    let mut var_name = header
    let mut words_text = ""
    if in_idx >= 0 is
        var_name = header[0..in_idx].trim()
        words_text = header[in_idx + 4..header.len()].trim()
    end
    let mut body_start = at + 1
    if !has_do is body_start = skip_bare_marker(lines, at + 1, "do") end
    let (body, stop_at) = parse_block(lines, body_start, ["done"])
    let mut next_i = stop_at
    if next_i < lines.len() is next_i = next_i + 1 end
    let stmt = Stmt { kind: "for", text: "", body: body, elif_conds: [], elif_bodies: [],
                       else_body: [], for_var: var_name, for_words: words_text, func_name: "" }
    return (stmt, next_i)
end

;; `function NAME { ... }` / `function NAME\n{ ... }`
fn parse_func_def(lines: [string], at: int) -> (Stmt, int) is
    let header = lines[at].trim()
    let after = header[8..header.len()].trim()   ;; strip "function"
    let mut name = after
    let brace_idx = after.index_of("{")
    if brace_idx >= 0 is name = after[0..brace_idx].trim() end
    let mut body_start = at + 1
    if brace_idx >= 0 is body_start = at + 1 end
    if brace_idx < 0 is body_start = skip_bare_marker(lines, at + 1, "{") end
    let (body, stop_at) = parse_block(lines, body_start, ["}"])
    let mut next_i = stop_at
    if next_i < lines.len() is next_i = next_i + 1 end
    let stmt = Stmt { kind: "func_def", text: "", body: body, elif_conds: [], elif_bodies: [],
                       else_body: [], for_var: "", for_words: "", func_name: name }
    return (stmt, next_i)
end

;; `NAME() { ... }`
fn parse_func_paren_def(lines: [string], at: int) -> (Stmt, int) is
    let header = lines[at].trim()
    let paren = header.index_of("()")
    let name = header[0..paren].trim()
    let after = header[paren + 2..header.len()].trim()
    let mut body_start = at + 1
    if after.starts_with("{") is body_start = at + 1 end
    if !after.starts_with("{") is body_start = skip_bare_marker(lines, at + 1, "{") end
    let (body, stop_at) = parse_block(lines, body_start, ["}"])
    let mut next_i = stop_at
    if next_i < lines.len() is next_i = next_i + 1 end
    let stmt = Stmt { kind: "func_def", text: "", body: body, elif_conds: [], elif_bodies: [],
                       else_body: [], for_var: "", for_words: "", func_name: name }
    return (stmt, next_i)
end

;; ── Shell state ──────────────────────────────────────────────────────────

struct Shell is
    pub v: any               ;; vars::ShellVars
    pub aliases: any          ;; hashmap
    pub theme_name: string
    pub last_dir: string
    pub history_file: string
    pub running: bool
    pub jobs: jobs::JobTable
    pub functions: any        ;; hashmap: name -> body text (newline-joined)
    pub control: string        ;; "" | "break" | "continue" | "return"
    pub shell_depth: int
    pub restricted: bool
    pub denied_commands: [string]
    pub confirm_dangerous: bool
    pub last_duration_ms: int
end

pub fn shell_new(shell_pid: int) -> Shell is
    return Shell {
        v: vars::vars_new(shell_pid), aliases: hashmap_new(), theme_name: "hacker",
        last_dir: "", history_file: "", running: true, jobs: jobs::jobs_new(),
        functions: hashmap_new(), control: "", shell_depth: 0, restricted: false,
        denied_commands: [], confirm_dangerous: true, last_duration_ms: -1,
    }
end

fn with_exit(mut sh: Shell, code: int) -> Shell is
    sh.v.last_exit = code
    return sh
end

;; ── external command execution ──────────────────────────────────────────
;; See the module doc comment: builtins are intercepted in-process
;; (they must mutate shell state); everything else is handed whole to
;; `process::run()`, which runs it via a real `sh -c` — so pipes,
;; redirects, globbing, `&&`/`||`/`;`, and subshells all work
;; correctly, just via the *system* shell.
;;
;; EXIT CODES: `process::run()` gives none. This file recovers one
;; anyway by appending a marker the real `sh` prints after the
;; command finishes (`; echo HSHEXIT:$?`) and parsing it back out of
;; the captured output before printing — invisible to the user, and
;; accurate for `if`/`while`/`&&`-style scripting that needs a real
;; exit code, at the cost of one extra `echo` per external command.

fn run_external_capture(cmd: string) -> (string, int) is
    let marker = "\x1eHSHEXIT:"
    let wrapped = cmd + "; printf '" + marker + "%d\\n' \"$?\""
    let raw = proc::run(wrapped)
    let idx = raw.index_of(marker)
    if idx < 0 is return (raw, 0) end
    let before = raw[0..idx]
    let after = raw[idx + marker.len()..raw.len()].trim()
    let mut code = 0
    if util::is_all_digits(after) is code = after.parse_int() end
    return (before, code)
end

pub fn run_external(mut sh: Shell, cmd: string) -> Shell is
    let (out, code) = run_external_capture(cmd)
    util::write_raw(out)
    return with_exit(sh, code)
end

;; ── condition evaluation (for if/while/until) ───────────────────────────
;; Runs `cond_text` as a full command (builtin-or-external, same path
;; as any other line) and returns its exit code (0 = true, matching
;; shell convention) together with the updated shell.

pub fn eval_condition(mut sh: Shell, hist: any, cond_text: string) -> (Shell, bool) is
    let expanded = vars::expand_line(sh.v, vars::expand_alias(sh.aliases, cond_text))
    sh = dispatch_line(sh, hist, expanded)
    return (sh, sh.v.last_exit == 0)
end

;; ── builtins ─────────────────────────────────────────────────────────────
;; Ported from builtins.rs, folded into this file — see the module doc
;; comment for why. `builtins_native.rs`'s reimplementations of `ls`/
;; `cat`/`grep`/etc are intentionally NOT ported: those already work
;; via `run_external` using the real system binaries.

fn builtin_cd(mut sh: Shell, arg: string) -> Shell is
    let home = util::getenv_safe("HOME")
    let cur = fs::cwd()
    let mut target = arg.trim()
    if target == "" is target = home end
    if target == "-" is
        if sh.last_dir == "" is
            write("cd: OLDPWD not set")
            return with_exit(sh, 1)
        end
        target = sh.last_dir
        write(target)
    end
    if target == "~" is target = home end
    if target.starts_with("~/") is target = home + target[1..target.len()] end

    if !fs::exists(target) is
        write("cd: no such file or directory: " + target)
        return with_exit(sh, 1)
    end
    if !fs::is_dir(target) is
        write("cd: not a directory: " + target)
        return with_exit(sh, 1)
    end
    fs::chdir(target)
    sh.last_dir = cur
    sh.v = vars::vars_set(sh.v, "PWD", fs::cwd())
    return with_exit(sh, 0)
end

fn builtin_export(mut sh: Shell, arg: string) -> Shell is
    let trimmed = arg.trim()
    if trimmed == "" is
        print_exported(sh.v)
        return with_exit(sh, 0)
    end
    let eq = trimmed.index_of("=")
    if eq < 0 is
        sh.v.exported.insert(trimmed, "1")
        return with_exit(sh, 0)
    end
    let name = trimmed[0..eq]
    let value = vars::expand_line(sh.v, util::strip_quotes(trimmed[eq + 1..trimmed.len()]))
    sh.v = vars::vars_export(sh.v, name, value)
    return with_exit(sh, 0)
end

fn print_exported(v: any) is
    let keys = v.exported.keys()
    let mut i = 0
    while i < keys.len() is
        let cur = i
        i = i + 1
        let k = to_string(keys[cur])
        write("export " + k + "=" + vars::vars_get(v, k))
    end
end

fn builtin_unset(mut sh: Shell, arg: string) -> Shell is
    sh.v = vars::vars_unset(sh.v, arg.trim())
    return with_exit(sh, 0)
end

fn builtin_readonly(mut sh: Shell, arg: string) -> Shell is
    let trimmed = arg.trim()
    let eq = trimmed.index_of("=")
    if eq >= 0 is
        let name = trimmed[0..eq]
        let value = vars::expand_line(sh.v, util::strip_quotes(trimmed[eq + 1..trimmed.len()]))
        sh.v = vars::vars_set(sh.v, name, value)
    end
    let mut name_only = trimmed
    if eq >= 0 is name_only = trimmed[0..eq] end
    sh.v.readonly.insert(name_only, "1")
    return with_exit(sh, 0)
end

fn builtin_alias(mut sh: Shell, arg: string) -> Shell is
    let trimmed = arg.trim()
    if trimmed == "" is
        print_aliases(sh.aliases)
        return with_exit(sh, 0)
    end
    let eq = trimmed.index_of("=")
    if eq < 0 is
        write("alias " + trimmed + "='" + vars::alias_get(sh.aliases, trimmed) + "'")
        return with_exit(sh, 0)
    end
    let name = trimmed[0..eq]
    let value = util::strip_quotes(trimmed[eq + 1..trimmed.len()])
    sh.aliases = vars::alias_set(sh.aliases, name, value)
    return with_exit(sh, 0)
end

fn print_aliases(aliases: any) is
    let keys = aliases.keys()
    let mut i = 0
    while i < keys.len() is
        let cur = i
        i = i + 1
        let k = to_string(keys[cur])
        write("alias " + k + "='" + vars::alias_get(aliases, k) + "'")
    end
end

fn builtin_unalias(mut sh: Shell, arg: string) -> Shell is
    sh.aliases = vars::alias_remove(sh.aliases, arg.trim())
    return with_exit(sh, 0)
end

fn builtin_set(mut sh: Shell, arg: string) -> Shell is
    let trimmed = arg.trim()
    if trimmed == "-e" is sh.v.opt_errexit = true end
    if trimmed == "+e" is sh.v.opt_errexit = false end
    if trimmed == "-x" is sh.v.opt_xtrace = true end
    if trimmed == "+x" is sh.v.opt_xtrace = false end
    if trimmed == "-u" is sh.v.opt_nounset = true end
    if trimmed == "+u" is sh.v.opt_nounset = false end
    return with_exit(sh, 0)
end

fn builtin_which(sh: Shell, arg: string) -> Shell is
    let name = arg.trim()
    if sh.aliases.contains_key(name) is
        write(name + ": aliased to " + vars::alias_get(sh.aliases, name))
        return sh
    end
    if sh.functions.contains_key(name) is
        write(name + ": function")
        return sh
    end
    let path = proc::which(name)
    if path == "" is
        write(name + ": not found")
        return with_exit(sh, 1)
    end
    write(path)
    return with_exit(sh, 0)
end

