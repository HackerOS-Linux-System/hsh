fn builtin_pushd(mut sh: Shell, arg: string) -> Shell is
    let target = arg.trim()
    if target == "" is
        write("pushd: brak katalogu")
        return with_exit(sh, 1)
    end
    let cur = fs::cwd()
    let stack = vars::vars_get(sh.v, "__DIRSTACK__")
    let mut new_stack = cur
    if stack != "" is new_stack = cur + "\n" + stack end
    if !fs::is_dir(target) is
        write("pushd: nie znaleziono katalogu: " + target)
        return with_exit(sh, 1)
    end
    fs::chdir(target)
    sh.v = vars::vars_set(sh.v, "__DIRSTACK__", new_stack)
    builtin_dirs(sh)
    return with_exit(sh, 0)
end

fn builtin_popd(mut sh: Shell) -> Shell is
    let stack = vars::vars_get(sh.v, "__DIRSTACK__")
    if stack == "" is
        write("popd: stos katalogów jest pusty")
        return with_exit(sh, 1)
    end
    let nl = stack.index_of("\n")
    let mut top = stack
    let mut rest = ""
    if nl >= 0 is
        top = stack[0..nl]
        rest = stack[nl + 1..stack.len()]
    end
    fs::chdir(top)
    sh.v = vars::vars_set(sh.v, "__DIRSTACK__", rest)
    builtin_dirs(sh)
    return with_exit(sh, 0)
end

fn builtin_dirs(sh: Shell) is
    let stack = vars::vars_get(sh.v, "__DIRSTACK__")
    let mut line = fs::cwd()
    if stack != "" is
        let parts = stack.split("\n")
        let mut i = 0
        while i < parts.len() is
            let cur = i
            i = i + 1
            line = line + " " + parts[cur]
        end
    end
    write(line)
end

fn builtin_jobs(sh: Shell) -> Shell is
    jobs::jobs_list(sh.jobs)
    return sh
end

fn builtin_fg(mut sh: Shell, arg: string) -> Shell is
    let id = parse_job_id(arg)
    if id < 0 is
        write("fg: nieprawidłowy numer zadania")
        return with_exit(sh, 1)
    end
    let pid = jobs::jobs_fg_pid(sh.jobs, id)
    if pid < 0 is
        write("fg: brak takiego zadania")
        return with_exit(sh, 1)
    end
    write("[" + to_string(id) + "] " + to_string(pid) + " (best-effort — brak prawdziwego przekazania terminala, patrz README.md)")
    return with_exit(sh, 0)
end

fn builtin_bg(mut sh: Shell, arg: string) -> Shell is
    let id = parse_job_id(arg)
    if id < 0 is
        write("bg: nieprawidłowy numer zadania")
        return with_exit(sh, 1)
    end
    jobs::jobs_bg(sh.jobs, id)
    return with_exit(sh, 0)
end

fn builtin_stop(mut sh: Shell, arg: string) -> Shell is
    let id = parse_job_id(arg)
    if id < 0 is
        write("stop: nieprawidłowy numer zadania")
        return with_exit(sh, 1)
    end
    jobs::jobs_stop(sh.jobs, id)
    return with_exit(sh, 0)
end

fn builtin_kill(mut sh: Shell, arg: string) -> Shell is
    let trimmed = arg.trim()
    if trimmed.starts_with("%") is
        let id = parse_job_id(trimmed)
        if id < 0 is
            write("kill: nieprawidłowy numer zadania")
            return with_exit(sh, 1)
        end
        jobs::jobs_send_signal(sh.jobs, id, "TERM")
        return with_exit(sh, 0)
    end
    proc::run("kill " + trimmed)
    return with_exit(sh, 0)
end

fn builtin_wait(mut sh: Shell) -> Shell is
    sh.jobs = jobs::jobs_check_finished(sh.jobs)
    return with_exit(sh, 0)
end

fn parse_job_id(arg: string) -> int is
    let mut t = arg.trim()
    if t.starts_with("%") is t = t[1..t.len()] end
    if !util::is_all_digits(t) is return -1 end
    return t.parse_int()
end

fn builtin_theme(mut sh: Shell, arg: string) -> Shell is
    let trimmed = arg.trim()
    if trimmed == "" is
        write("aktualny motyw: " + sh.theme_name)
        write("dostępne: " + theme::theme_names().join(", "))
        return with_exit(sh, 0)
    end
    sh.theme_name = trimmed
    return with_exit(sh, 0)
end

fn builtin_hsh_audit(sh: Shell, arg: string) -> Shell is
    let home = util::getenv_safe("HOME")
    let result = security::verify_audit_log(home)
    if result.ok is
        write("dziennik audytu: OK (" + to_string(result.count) + " wpisów, łańcuch nienaruszony)")
        return sh
    end
    write("dziennik audytu: USZKODZONY od linii " + to_string(result.broken_at))
    return with_exit(sh, 1)
end

fn builtin_hsh_version() is
    write("hsh (H# port) 0.1.0")
end

;; ── statement executor (script control flow) ────────────────────────────
;; `sh.control` carries a break/continue/return signal up through the
;; call stack: "" (normal), "break", "continue", "return". Loops
;; consume break/continue (clearing `sh.control` back to ""); function
;; calls consume "return". Every statement handler here returns `sh`
;; from *inside* whichever branch actually ran — see the module doc
;; comment's note on the interpreter bug this avoids.

pub fn exec_stmt_list(mut sh: Shell, hist: any, stmts: [Stmt]) -> Shell is
    let mut i = 0
    let mut stop = false
    while i < stmts.len() && !stop is
        let cur = i
        i = i + 1
        sh = exec_stmt(sh, hist, stmts[cur])
        if sh.control != "" is stop = true end
    end
    return sh
end

fn exec_stmt(mut sh: Shell, hist: any, stmt: Stmt) -> Shell is
    if stmt.kind == "cmd" is return exec_cmd_stmt(sh, hist, stmt.text) end
    if stmt.kind == "assign" is return exec_assign_stmt(sh, stmt.text) end
    if stmt.kind == "if" is return exec_if_stmt(sh, hist, stmt) end
    if stmt.kind == "while" is return exec_while_stmt(sh, hist, stmt) end
    if stmt.kind == "until" is return exec_until_stmt(sh, hist, stmt) end
    if stmt.kind == "for" is return exec_for_stmt(sh, hist, stmt) end
    if stmt.kind == "func_def" is return exec_func_def_stmt(sh, stmt) end
    if stmt.kind == "break" is
        sh.control = "break"
        return sh
    end
    if stmt.kind == "continue" is
        sh.control = "continue"
        return sh
    end
    if stmt.kind == "return" is
        let mut code = sh.v.last_exit
        if stmt.text.trim() != "" is
            if util::is_all_digits(stmt.text.trim()) is code = stmt.text.trim().parse_int() end
        end
        sh.v.last_exit = code
        sh.control = "return"
        return sh
    end
    return sh
end

fn exec_assign_stmt(mut sh: Shell, text: string) -> Shell is
    let eq = text.index_of("=")
    let name = text[0..eq]
    let value = vars::expand_line(sh.v, util::strip_quotes(text[eq + 1..text.len()]))
    sh.v = vars::vars_set(sh.v, name, value)
    return with_exit(sh, 0)
end

fn exec_cmd_stmt(mut sh: Shell, hist: any, text: string) -> Shell is
    let expanded = vars::expand_line(sh.v, vars::expand_alias(sh.aliases, text))
    sh = dispatch_line(sh, hist, expanded)
    if sh.v.opt_errexit is
        if sh.v.last_exit != 0 is sh.control = "return" end
    end
    return sh
end

fn exec_if_stmt(mut sh: Shell, hist: any, stmt: Stmt) -> Shell is
    let (sh1, matched) = eval_condition(sh, hist, stmt.text)
    sh = sh1
    if matched is
        return exec_stmt_list(sh, hist, stmt.body)
    end
    return exec_if_elifs(sh, hist, stmt, 0)
end

fn exec_if_elifs(mut sh: Shell, hist: any, stmt: Stmt, idx: int) -> Shell is
    if idx >= stmt.elif_conds.len() is
        return exec_stmt_list(sh, hist, stmt.else_body)
    end
    let (sh1, matched) = eval_condition(sh, hist, stmt.elif_conds[idx])
    sh = sh1
    if matched is
        return exec_stmt_list(sh, hist, stmt.elif_bodies[idx])
    end
    return exec_if_elifs(sh, hist, stmt, idx + 1)
end

fn exec_while_stmt(mut sh: Shell, hist: any, stmt: Stmt) -> Shell is
    let mut going = true
    while going is
        let (sh1, matched) = eval_condition(sh, hist, stmt.text)
        sh = sh1
        if !matched is going = false end
        if matched is
            sh = exec_stmt_list(sh, hist, stmt.body)
            if sh.control == "break" is
                sh.control = ""
                going = false
            end
            if sh.control == "continue" is sh.control = "" end
            if sh.control == "return" is going = false end
        end
    end
    return sh
end

fn exec_until_stmt(mut sh: Shell, hist: any, stmt: Stmt) -> Shell is
    let mut going = true
    while going is
        let (sh1, matched) = eval_condition(sh, hist, stmt.text)
        sh = sh1
        if matched is going = false end
        if !matched is
            sh = exec_stmt_list(sh, hist, stmt.body)
            if sh.control == "break" is
                sh.control = ""
                going = false
            end
            if sh.control == "continue" is sh.control = "" end
            if sh.control == "return" is going = false end
        end
    end
    return sh
end

fn exec_for_stmt(mut sh: Shell, hist: any, stmt: Stmt) -> Shell is
    let expanded_words = vars::expand_line(sh.v, stmt.for_words)
    let words = split_ws(expanded_words)
    let mut i = 0
    let mut going = true
    while i < words.len() && going is
        let cur = i
        i = i + 1
        sh.v = vars::vars_set(sh.v, stmt.for_var, words[cur])
        sh = exec_stmt_list(sh, hist, stmt.body)
        if sh.control == "break" is
            sh.control = ""
            going = false
        end
        if sh.control == "continue" is sh.control = "" end
        if sh.control == "return" is going = false end
    end
    return sh
end

fn split_ws(s: string) -> [string] is
    return __builtin_str_split_whitespace(s)
end

fn exec_func_def_stmt(mut sh: Shell, stmt: Stmt) -> Shell is
    sh.functions.insert(stmt.func_name, stmt.body)
    return with_exit(sh, 0)
end

;; Calls a user-defined function: sets positional params ($1, $2, ...)
;; from `args`, runs the body, restores the caller's positional
;; params afterward, and consumes a "return" signal (so it doesn't
;; propagate past the function boundary).
fn call_function(mut sh: Shell, hist: any, name: string, args: [string]) -> Shell is
    ;; BUG FIX (H-Sharp compiler side): was `sh.functions.get(name)`.
    ;; `.get(...)` method-call syntax is ambiguous between an array's
    ;; `.get(index)` and a hashmap's `.get(key)` (nothing at codegen
    ;; time knows which `sh.functions` is — `any` is opaque by design),
    ;; so this now calls the unambiguous native `map_get(...)` builtin
    ;; directly. Deliberately `map_get`, not `map_get_str`: a function's
    ;; body is a `[Stmt]` array (see `sh.functions.insert(stmt.func_name,
    ;; stmt.body)` below), not a string, and `map_get` returns the
    ;; generic value untyped (coerced to whatever the call site actually
    ;; needs) rather than `map_get_str`'s string-specific reinterpretation.
    let body = map_get(sh.functions, name)
    let saved_positional = sh.v.positional
    sh.v.positional = args
    sh = exec_stmt_list(sh, hist, body)
    if sh.control == "return" is sh.control = "" end
    sh.v.positional = saved_positional
    return sh
end

;; ── main dispatch ────────────────────────────────────────────────────────

fn builtin_eval(mut sh: Shell, hist: any, arg: string) -> Shell is
    let expanded = vars::expand_line(sh.v, arg)
    return dispatch_line(sh, hist, expanded)
end

fn builtin_read(mut sh: Shell, arg: string) -> Shell is
    let name = arg.trim()
    let val = io::read_line("")
    if name != "" is sh.v = vars::vars_set(sh.v, name, val) end
    return with_exit(sh, 0)
end

;; Dispatches one already alias/var/tilde/arithmetic-expanded line:
;; builtin, else a user-defined function, else delegate externally
;; (through the security checks). This is the single entry point every
;; other executor above funnels into for a leaf command.
pub fn dispatch_line(mut sh: Shell, hist: any, line: string) -> Shell is
    let trimmed = line.trim()
    if trimmed == "" is return sh end

    let cmd = util::first_word(trimmed)
    let arg = util::rest_after_first_word(trimmed)

    if cmd == "cd" is return builtin_cd(sh, arg) end
    if cmd == "pwd" is
        write(fs::cwd())
        return with_exit(sh, 0)
    end
    if cmd == "exit" is
        sh.running = false
        let mut code = 0
        if arg.trim() != "" is
            if util::is_all_digits(arg.trim()) is code = arg.trim().parse_int() end
        end
        return with_exit(sh, code)
    end
    if cmd == "export" is return builtin_export(sh, arg) end
    if cmd == "unset" is return builtin_unset(sh, arg) end
    if cmd == "readonly" is return builtin_readonly(sh, arg) end
    if cmd == "declare" is return builtin_export(sh, arg) end
    if cmd == "typeset" is return builtin_export(sh, arg) end
    if cmd == "local" is return exec_assign_stmt(sh, arg) end
    if cmd == "alias" is return builtin_alias(sh, arg) end
    if cmd == "unalias" is return builtin_unalias(sh, arg) end
    if cmd == "set" is return builtin_set(sh, arg) end
    if cmd == "history" is
        util::write_raw("")
        return with_exit(sh, 0)   ;; real history display is wired in main.h# (has the hp::History)
    end
    if cmd == "which" is return builtin_which(sh, arg) end
    if cmd == "type" is return builtin_which(sh, arg) end
    if cmd == "help" is
        builtin_help()
        return with_exit(sh, 0)
    end
    if cmd == "true" is return with_exit(sh, 0) end
    if cmd == "false" is return with_exit(sh, 1) end
    if cmd == ":" is return with_exit(sh, 0) end
    if cmd == "theme" is return builtin_theme(sh, arg) end
    if cmd == "read" is return builtin_read(sh, arg) end
    if cmd == "eval" is return builtin_eval(sh, hist, arg) end
    if cmd == "pushd" is return builtin_pushd(sh, arg) end
    if cmd == "popd" is return builtin_popd(sh) end
    if cmd == "dirs" is
        builtin_dirs(sh)
        return with_exit(sh, 0)
    end
    if cmd == "jobs" is return builtin_jobs(sh) end
    if cmd == "fg" is return builtin_fg(sh, arg) end
    if cmd == "bg" is return builtin_bg(sh, arg) end
    if cmd == "stop" is return builtin_stop(sh, arg) end
    if cmd == "kill" is return builtin_kill(sh, arg) end
    if cmd == "wait" is return builtin_wait(sh) end
    if cmd == "hsh-audit" is return builtin_hsh_audit(sh, arg) end
    if cmd == "hsh-version" is
        builtin_hsh_version()
        return with_exit(sh, 0)
    end
    if cmd == "source" is return run_script_file(sh, hist, arg.trim()) end
    if cmd == "." is return run_script_file(sh, hist, arg.trim()) end

    if sh.functions.contains_key(cmd) is
        return call_function(sh, hist, cmd, split_ws(arg))
    end

    return dispatch_external(sh, trimmed, cmd, arg)
end

;; The non-builtin, non-function fallback: restricted-mode / denied-
;; command / dangerous-command checks, then `run_external`.
fn dispatch_external(mut sh: Shell, trimmed: string, cmd: string, arg: string) -> Shell is
    if sh.restricted is
        let violation = security::restricted_violation(trimmed)
        if violation != "" is
            write("hsh: zablokowane w trybie restricted: " + violation)
            return with_exit(sh, 1)
        end
    end

    let denied_hit = security::is_denied_command(trimmed, sh.denied_commands)
    if denied_hit != "" is
        write("hsh: polecenie zablokowane w konfiguracji: " + denied_hit)
        return with_exit(sh, 1)
    end

    if sh.confirm_dangerous is
        let ok = security::confirm_dangerous(trimmed)
        if !ok is
            write("przerwano")
            return with_exit(sh, 1)
        end
    end

    return run_external(sh, trimmed)
end

;; ── script file execution (source / .) ──────────────────────────────────

pub fn run_script_file(mut sh: Shell, hist: any, path: string) -> Shell is
    if !fs::exists(path) is
        write("hsh: " + path + ": nie znaleziono pliku")
        return with_exit(sh, 1)
    end
    let lines = fs::read_lines(path)
    let (stmts, _stop) = parse_block(lines, 0, [])
    return exec_stmt_list(sh, hist, stmts)
end
