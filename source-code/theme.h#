pub fn theme_by_name(name: string) -> Theme is
    if name == "default" is return theme_default() end
    if name == "cosmic" is return theme_cosmic() end
    if name == "nord" is return theme_nord() end
    if name == "gruvbox" is return theme_gruvbox() end
    if name == "dracula" is return theme_dracula() end
    if name == "hackeros" is return theme_hackeros() end
    if name == "solarized-light" is return theme_solarized_light() end
    if name == "solarized-dark" is return theme_solarized_dark() end
    if name == "tomorrow-night" is return theme_tomorrow_night() end
    if name == "monokai" is return theme_monokai() end
    if name == "ayu-dark" is return theme_ayu_dark() end
    if name == "ayu-light" is return theme_ayu_light() end
    if name == "one-dark" is return theme_one_dark() end
    if name == "catppuccin-mocha" is return theme_catppuccin_mocha() end
    if name == "everforest" is return theme_everforest() end
    if name == "tokyo-night" is return theme_tokyo_night() end
    if name == "kanagawa" is return theme_kanagawa() end
    if name == "rose-pine" is return theme_rose_pine() end
    if name == "cyberpunk" is return theme_cyberpunk() end
    if name == "nord-light" is return theme_nord_light() end
    return theme_default()   ;; fallback: default
end
